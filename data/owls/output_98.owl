    <TTEXTS:has_atos_reading_level rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3.3</TTEXTS:has_atos_reading_level>
    <TTEXTS:has_reader_maturity rdf:resource="https://koncordantlab.com/TTEXTS/9_to_12"/>
