    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_text_structure rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_language_conventionality_and_clarity rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
