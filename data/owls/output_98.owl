  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/of_mice_and_men">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/john_steinbeck"/>
