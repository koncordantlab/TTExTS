  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/if">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/rudyard_kipling"/>
