    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.4</TTEXTS:has_flesch_kincaid>
