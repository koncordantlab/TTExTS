  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/metamorphosis">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/franz_kafka"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">64.0</TTEXTS:has_pages>
