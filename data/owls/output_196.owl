  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/poet_x">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/elizabeth_acevedo"/>
