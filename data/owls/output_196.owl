    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.2</TTEXTS:has_flesch_kincaid>
