  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/o_captain_my_captain">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/walt_whitman"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">O Captain! My Captain! is an elegy mourning the death of a beloved leader, widely interpreted as President Abraham Lincoln. The poem uses the metaphor of a ships captain who has successfully guided his vessel through a storm, only to die just as the journey ends, expressing both sorrow and a sense of victory.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1865</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
