  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_lady_or_the_tiger?">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/frank_r_stockton"/>
