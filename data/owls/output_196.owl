    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ode to a Large Tuna in the Market celebrates the humble tuna fish, honoring its strength, vitality, and vital role in lifes cycle through vivid and affectionate imagery.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1954</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Contemporary"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
    <TTEXTS:has_text_structure rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
