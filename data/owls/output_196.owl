    <TTEXTS:has_text_complexity rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_lexile_level rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">610</TTEXTS:has_lexile_level>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.8</TTEXTS:has_flesch_kincaid>
