  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/stopping_by_woods_on_a_snowy_evening">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/robert_frost"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The poem describes a quiet moment as the speaker pauses to admire the peaceful, snow-filled woods. Though drawn to their stillness and beauty, he reminds himself of responsibilities and commitments that require him to move on.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1923</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_text_structure rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_language_conventionality_and_clarity rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.6</TTEXTS:has_flesch_kincaid>
    <TTEXTS:has_atos_reading_level rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.1</TTEXTS:has_atos_reading_level>
    <TTEXTS:has_reader_maturity rdf:resource="https://koncordantlab.com/TTEXTS/5_to_8"/>
    <TTEXTS:has_genre rdf:resource="https://koncordantlab.com/TTEXTS/genre/Poetry"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Man_vs_Nature"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Death"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Purpose"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Solitude"/>
