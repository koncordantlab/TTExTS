  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_book_thief">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/markus_zusak"/>
