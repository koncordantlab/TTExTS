    <TTEXTS:has_subtheme rdf:resource="https://koncordantlab.com/TTEXTS/subtheme/Heroism"/>
    <TTEXTS:has_subtheme rdf:resource="https://koncordantlab.com/TTEXTS/subtheme/Classic"/>
    <TTEXTS:has_subtheme rdf:resource="https://koncordantlab.com/TTEXTS/subtheme/Sensational"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/harlem">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/langston_hughes"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Harlem focuses on the experiences of African Americans in Harlem, highlighting the social and racial injustices that force many to delay or abandon their dreams. It explores the frustration and consequences of deferred dreams, questioning what happens when hopes and aspirations are continually postponed. </TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1951</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Contemporary"/>
