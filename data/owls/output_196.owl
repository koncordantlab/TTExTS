  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/im_nobody!_who_are_you?">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/emily_dickinson"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The speaker embraces being a "Nobody" and questions the value of fame, suggesting that being anonymous is preferable to the public, performative life of a "Somebody." It playfully explores themes of identity and social conformity. </TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1891</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_text_structure rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_language_conventionality_and_clarity rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.4</TTEXTS:has_flesch_kincaid>
    <TTEXTS:has_atos_reading_level rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.52</TTEXTS:has_atos_reading_level>
    <TTEXTS:has_reader_maturity rdf:resource="https://koncordantlab.com/TTEXTS/7_to_12"/>
    <TTEXTS:has_genre rdf:resource="https://koncordantlab.com/TTEXTS/genre/Lyric"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Identity"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Individuality"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Conformity"/>
