  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/things_fall_apart">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/chinua_achebe"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">224.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Things Fall Apart tells the story of Okonkwo, whose resistance to cultural change and fear of weakness leads to his tragic downfall amidst the upheaval of European colonialism and the collapse of traditional Igbo society.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1958</TTEXTS:has_year_of_publication>
