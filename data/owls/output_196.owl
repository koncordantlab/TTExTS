  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/casey_at_the_bat">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/ernest_lawrence_thayer"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Casey at the Bat" tells the story of a confident baseball hero who, to the crowds shock and disappointment, strikes out at a crucial moment, highlighting the unpredictability of sports and the fallibility of even the greatest.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1888</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_text_structure rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_language_conventionality_and_clarity rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_text_complexity rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_lexile_level rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">810L-1000L</TTEXTS:has_lexile_level>
