  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/theseus_and_the_minotaur">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/sonia_elisabetta_corvaglia"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">32.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Picture_Book"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A retelling of the Greek myth in which the hero Theseus ventures into the labyrinth to defeat the Minotaur, a fearsome creature, with the help of Ariadne's thread, symbolizing bravery, ingenuity, and the triumph of good over evil.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</TTEXTS:has_year_of_publication>
