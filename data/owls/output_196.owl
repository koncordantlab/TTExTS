    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Invictus expresses unwavering determination and personal strength in the face of adversity. The speaker emphasizes self-mastery and the power of the human will to endure suffering without surrendering to despair.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1888</TTEXTS:has_year_of_publication>
