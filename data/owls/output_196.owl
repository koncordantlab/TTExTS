  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/i_lost_my_talk">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/rita_joe"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rita Joe's poem "I Lost My Talk" poignantly recounts the forced loss of her Mi'kmaw language during her time at the Shubenacadie Residential School, highlighting the cultural and personal impact of this erasure while expressing a hopeful desire to reclaim and share her heritage.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1978</TTEXTS:has_year_of_publication>
