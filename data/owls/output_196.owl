  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/picture_of_dorian_gray">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/oscar_wilde"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">240.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dorian Gray falls under the influence of a hedonistic aristocrat, makes a Faustian wish to stay eternally youthful while his portrait ages in his place, and descends into a life of indulgence and crime as his portrait reflects the consequences of his actions.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1890</TTEXTS:has_year_of_publication>
