  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/a_litany_in_time_of_plague">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/thomas_nashe"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In a solemn reflection on the fragility of life during a deadly plague, the poem emphasizes that wealth, beauty, and status are powerless against death, highlighting the universality and inevitability of human mortality.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1593</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
    <TTEXTS:has_text_structure rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_language_conventionality_and_clarity rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.9</TTEXTS:has_flesch_kincaid>
    <TTEXTS:has_atos_reading_level rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.74</TTEXTS:has_atos_reading_level>
    <TTEXTS:has_reader_maturity rdf:resource="https://koncordantlab.com/TTEXTS/9_to_12"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Mortality"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Death"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Self_destruction"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Limits_of_human_agency"/>
    <TTEXTS:has_subtheme rdf:resource="https://koncordantlab.com/TTEXTS/subtheme/Christian_values"/>
