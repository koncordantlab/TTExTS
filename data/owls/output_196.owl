  </rdf:Description>
  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_hill_we_climb">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/amanda_gorman"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The inaugural poem The Hill We Climb is a hopeful and inspiring call for unity and resilience in America. It acknowledges the countrys struggles and divisions but emphasizes collective strength, healing, and the promise of a better future through shared effort and courage.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2021</TTEXTS:has_year_of_publication>
