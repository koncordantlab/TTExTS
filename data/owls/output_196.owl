  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/on_turning_ten">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/billy_collins"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In a reflection of the bittersweet experience of leaving childhood behind, the speaker mourns the loss of youthful innocence and imagination, recognizing that growing older means facing a more complicated and less magical world. </TTEXTS:has_summary>
