  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/tattoo">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/ted_kooser"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"Tattoo" reflects on an older man's faded tattoo, once a symbol of youthful rebellion and vitality. The speaker observes how time has softened both the ink and the man himself, suggesting the inevitability of aging and the quiet transformation of identity over time.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2003</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Contemporary"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
