  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/twleve_angry_men">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/reginald_rose"/>
