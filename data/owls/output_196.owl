  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_perks_of_being_a_wallflower">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/stephen_chbosky"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">224.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Charlie, an introverted high school freshman, navigates the challenges of adolescence, mental health, and first love through a series of letters as he tries to find his place in the world. With the help of new friends Sam and Patrick, he begins to step out of the shadows and confront the trauma of his past.</TTEXTS:has_summary>
