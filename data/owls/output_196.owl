  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_thing_around_your_neck">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/chimamanda_ngozi_adichie"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">300.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Short_Story_Collection"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In these twelve stories, Chimamanda Ngozi Adichie explores the emotional and cultural tensions faced by Nigerians navigating life between Africa and the United States, illuminating with beauty, sorrow, and emotional wisdom the ties that bind families, lovers, and identities across continents.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2009</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Contemporary"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
    <TTEXTS:has_text_structure rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_language_conventionality_and_clarity rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
    <TTEXTS:has_reader_maturity rdf:resource="https://koncordantlab.com/TTEXTS/9_to_12"/>
    <TTEXTS:has_genre rdf:resource="https://koncordantlab.com/TTEXTS/genre/Fiction"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Facing_racism"/>
    <TTEXTS:has_theme rdf:resource="https://koncordantlab.com/TTEXTS/theme/Cultural_identity"/>
    <TTEXTS:has_subtheme rdf:resource="https://koncordantlab.com/TTEXTS/subtheme/Gender_Roles"/>
    <TTEXTS:has_subtheme rdf:resource="https://koncordantlab.com/TTEXTS/subtheme/Political"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/eleanor_and_park">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/rainbow_rowell"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">320.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eleanor and Park fall in love over comics and mixtapes, but their relationship makes them question the cruelty, abuse, and expectations of their 1980s high school world.</TTEXTS:has_summary>
