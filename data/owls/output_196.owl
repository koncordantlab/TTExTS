  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/all_summer_in_a_day">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/ray_bradbury"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">15.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Short_Story"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A group of children are living on Venus, where the sun only shines for two hours every seven years, and tragic consequences unfold when they lock a classmate, Margot, in a closet and miss the rare glimpse of sunlight.</TTEXTS:has_summary>
