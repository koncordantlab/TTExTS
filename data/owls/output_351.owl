  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/born_a_crime">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/trevor_noah"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">304.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Born a Crime by Trevor Noah is a memoir recounting his childhood in apartheid and post-apartheid South Africa, where, as a mixed-race child born to a Black mother and white father, he navigates poverty, racism, and identity with humor, resilience, and deep love for his fearless mother.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2016</TTEXTS:has_year_of_publication>
