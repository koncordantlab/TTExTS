  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/death_on_the_nile">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/agatha_christie"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">288.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">While honeymooning in Egypt, wealthy heiress Linnet Ridgeway is murdered aboard a Nile steamer, prompting detective Hercule Poirot to unravel a complex web of deception, betrayal, and loveultimately revealing that her death was the result of a calculated plot by her new husband Simon Doyle and his former lover Jacqueline de Bellefort.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1937</TTEXTS:has_year_of_publication>
