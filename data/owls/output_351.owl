    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">After a shipwreck leaves him stranded in the Pacific Ocean, young Pi Patel survives 227 days at sea in a lifeboat with a Bengal tiger, leading to a profound exploration of faith, survival, and the blurry line between fact and fiction.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2001</TTEXTS:has_year_of_publication>
