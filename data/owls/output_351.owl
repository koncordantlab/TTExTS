    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In a tense monologue set in Lahore, a former Pakistani elite named Changez recounts his disillusionment with the American dream after 9/11, revealing a complex journey of identity, loyalty, and alienation.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2007</TTEXTS:has_year_of_publication>
