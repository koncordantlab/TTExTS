  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/woman_at_point_zero">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/nawal_el_saadawi"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">152.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Firdaus, a woman on death row in Egypt, recounts her harrowing journey through abuse, exploitation, and self-discovery, culminating in a final act of defiance that challenges societal norms and exposes the systemic oppression of women.</TTEXTS:has_summary>
