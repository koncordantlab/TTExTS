    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">160.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In The Screwtape Letters, C.S. Lewis presents a satirical and spiritual narrative in which a senior demon, Screwtape, advises his inept nephew, Wormwood, on how to tempt a British manreferred to as "the Patient"into sin and damnation, ultimately failing when the man dies a faithful Christian and Wormwood is condemned to be devoured for his failure.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1942</TTEXTS:has_year_of_publication>
