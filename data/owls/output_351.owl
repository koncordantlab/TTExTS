  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/all_the_light_we_cannot_see">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/anthony_doerr"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">531.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">All the Light We Cannot See follows the intersecting lives of Marie-Laure, a blind French girl aiding the resistance, Werner, a German boy forced into the Nazi war machine, and von Rumpel, a dying Nazi hunting a legendary diamond, all converging in war-torn Saint-Malo as they grapple with fate, morality, and the unseen forces that connect us.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2014</TTEXTS:has_year_of_publication>
