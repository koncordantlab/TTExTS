    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Sound and the Fury by William Faulkner is a fragmented, stream-of-consciousness novel that traces the decline of the once-aristocratic Compson family in the American South through the troubled inner lives of its four narrators.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1929</TTEXTS:has_year_of_publication>
