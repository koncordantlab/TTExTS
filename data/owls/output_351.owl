  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_handmaids_tale">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/margaret_atwood"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">311.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In the dystopian society of Gilead, where fertile women are forced into reproductive servitude, Offred serves as a Handmaid to a powerful Commander. As she navigates a world stripped of identity and freedom, she quietly resists and clings to memories, hope, and the possibility of escape.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1985</TTEXTS:has_year_of_publication>
