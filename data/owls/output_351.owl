  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/twenty_thousand_leagues_under_the_sea">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/jules_verne"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">212.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In Twenty Thousand Leagues Under the Sea, Professor Aronnax, his servant Conseil, and harpooner Ned Land are taken captive aboard the advanced submarine Nautilus, where under the enigmatic Captain Nemo, they embark on a fantastical, perilous journey beneath the oceanswitnessing marine wonders and tragediesuntil they ultimately escape as the vessel disappears into a violent maelstrom.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1870</TTEXTS:has_year_of_publication>
