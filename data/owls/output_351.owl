    <TTEXTS:has_language_conventionality_and_clarity rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_knowledge_demands rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_text_complexity rdf:resource="https://koncordantlab.com/TTEXTS/Moderately_Complex"/>
    <TTEXTS:has_lexile_level rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">1160</TTEXTS:has_lexile_level>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.32</TTEXTS:has_flesch_kincaid>
