    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">24.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Short_Story"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A young boy tries to steal a womans purse, only to have her show him kindness by taking him to her home, feeding him, and teaching him a lesson about trust and respect.</TTEXTS:has_summary>
