  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/a_tree_grows_in_brooklyn">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/betty_smith"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">493.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Tree Grows in Brooklyn follows Francie Nolans coming of age in early 20th-century Brooklyn, as she navigates poverty, family hardship, loss, and self-discovery, ultimately emerging with resilience and hope for a better future.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1943</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
