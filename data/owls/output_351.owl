  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_abolition_of_man">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/c_s_lewis"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">128.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Non_Fiction_Book_Text_Type"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">C.S. Lewis argues that abandoning objective moral values in education and culture leads to the erosion of humanity itself, ultimately creating "men without chests"intellectually capable but morally hollow individuals.</TTEXTS:has_summary>
