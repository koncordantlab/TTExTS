  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/stargirl">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/jerry_spinelli"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">169.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">When the eccentric and free-spirited Stargirl arrives at her new high school, her uniqueness makes her an outcast, and this forces her classmate, Leo, to question the value of fitting in versus staying true to oneself.</TTEXTS:has_summary>
