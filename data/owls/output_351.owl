  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_yellow_wallpaper">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/charlotte_perkins_gilman"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">22.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Short_Story"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A woman suffering from postpartum depression is confined by her husbands strict treatment, leading her to obsess over the rooms wallpaper and slowly descend into madness.</TTEXTS:has_summary>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Confined to a room as a "rest cure" for her postpartum depression, a woman slowly descends into madness, projecting her growing sense of entrapment onto the eerie yellow wallpaper covering the walls.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1892</TTEXTS:has_year_of_publication>
