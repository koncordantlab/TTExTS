    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Memoir_Text_Type"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Glennon Doyle chronicles her transformative journey of self-discovery, shedding societal expectations to embrace her authentic self, including her identity as a queer woman, and inspiring others to live unapologetically.</TTEXTS:has_summary>
