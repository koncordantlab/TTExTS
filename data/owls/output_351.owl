  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/importance_of_being_earnest">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/oscar_wilde"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">58.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Drama_Text_Type"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Jack Worthing and Algernon Moncrieff both lead double lives under the name "Ernest" to pursue love and freedom, but their deceptions unravel when they both fall for women fixated on the name Ernest, leading to comedic misunderstandings and a surprising family revelation.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1895</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
