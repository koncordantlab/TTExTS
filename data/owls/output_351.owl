    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The speaker has a joyful experience of coming across a field of golden daffodils. The memory of the vibrant flowers uplifts his spirits whenever he feels lonely or down, celebrating natures power to inspire and bring lasting happiness.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1807</TTEXTS:has_year_of_publication>
