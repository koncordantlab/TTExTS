  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/murder_on_the_orient_express">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/agatha_christie"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">274.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hercule Poirot, a famous Belgian detective, hops onto the luxerious Orient Express Train. On this train, a wealthy American named Samuel Ratchett is found murdered in his cabin. The train is stopped by a snowdrift, and Poirot is asked to investigate. As he interviews the passengers, he uncovers that many of them are connected to a tragic kidnapping and murder case from years earlier involving a girl named Daisy Armstrong.</TTEXTS:has_summary>
