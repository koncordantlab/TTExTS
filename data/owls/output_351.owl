  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/david_copperfield">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/charles_dickens"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">1024.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">David Copperfield recounts his life from a troubled childhood through personal loss, love, and betrayal, ultimately finding purpose, maturity, and happiness through love, hard work, and writing.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1850</TTEXTS:has_year_of_publication>
