  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/out_of_my_mind">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/sharon_m_draper"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">295.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eleven-year-old Melody, a brilliant girl with cerebral palsy who cannot speak or walk, fights to show the world she is more than her disability. When she gains a way to communicate, she challenges others assumptions and finds her voice in a world that too often overlooks her.</TTEXTS:has_summary>
