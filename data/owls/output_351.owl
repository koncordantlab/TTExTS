    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Epic_Poem_Text_Type"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Paradise Lost tells the story of Satans rebellion against God, his fall from Heaven, and his role in the temptation of Adam and Eve, which leads to humanitys loss of Paradise. The poem explores themes of free will, obedience, and the nature of good and evil.</TTEXTS:has_summary>
