    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Lale Sokolov is chosen to be the tattooist at Auschwitz, and this allows him to survive, help fellow prisoners, and fall in love, even in the face of overwhelming horror.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2017</TTEXTS:has_year_of_publication>
