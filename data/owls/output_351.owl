    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bilbo is recruited by Gandalf and a group of dwarves to help reclaim their mountain home from the dragon Smaug, forcing him to leave behind his quiet, predictable life.</TTEXTS:has_summary>
