  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_road_not_taken">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/robert_frost"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">"The Road Not Taken" by Robert Frost reflects on how choices shape our lives, emphasizing the significance and lasting impact of choosing a less conventional path.</TTEXTS:has_summary>
