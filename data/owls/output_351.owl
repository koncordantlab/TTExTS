  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_tipping_point:_how_little_things_can_make_a_big_difference">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/malcolm_gladwell"/>
