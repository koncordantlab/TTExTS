  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/ulysses">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/james_joyce"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">783.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spanning a single day in Dublin, Ulysses follows Leopold Blooms ordinary yet deeply symbolic journey through the city, mirroring Homers Odyssey while exploring identity, memory, and the stream of human consciousness.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1920</TTEXTS:has_year_of_publication>
