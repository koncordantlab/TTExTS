  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/as_i_lay_dying">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/william_faulkner"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">208.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Addie Bundrens dying wish to be buried in her hometown sets her impoverished family on a grueling journey fraught with physical hardships, personal struggles, and secrets, culminating in her burial and the fracturing of the family, especially with her son Darls mental breakdown and Dewey Dells desperate attempts to deal with her unwanted pregnancy.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1930</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Traditional"/>
    <TTEXTS:has_levels_of_meaning rdf:resource="https://koncordantlab.com/TTEXTS/Very_Complex"/>
