    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Hester Prynne bears an illegitimate child and is condemned to wear a scarlet letter "A" on her chest as a symbol of her adultery, but remains strong and dignified eve in the harshness of Puritanical society. </TTEXTS:has_summary>
