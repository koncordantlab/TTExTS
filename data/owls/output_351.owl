    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Non_Fiction_Book_Text_Type"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Malcolm Gladwell explores how small actions or events can trigger major social change, revealing the people, patterns, and moments that cause ideas, behaviors, and trends to reach a critical tipping point and spread like wildfire.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2000</TTEXTS:has_year_of_publication>
