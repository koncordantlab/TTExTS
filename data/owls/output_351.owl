  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/when_stars_are_scattered">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/omar_mohamed_and_victoria_jamieson"/>
