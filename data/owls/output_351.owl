  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/the_sound_and_the_fury">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/william_faulkner"/>
