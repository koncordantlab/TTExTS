  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/from_the_mixed_up_files_of_mrs_basil_e_frankweiler">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
