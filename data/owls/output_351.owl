  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/looking_for_alaska">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/john_green"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">272.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A lonely teenager named Miles Pudge Halter attends a boarding school in search of a Great Perhaps, where he forms deep friendships, falls in love with the mysterious Alaska Young, and is forever changed by her tragic death, which leads him to grapple with love, loss, and the meaning of life.</TTEXTS:has_summary>
