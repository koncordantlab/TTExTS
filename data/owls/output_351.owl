    <TTEXTS:has_text_complexity rdf:resource="https://koncordantlab.com/TTEXTS/Slightly_Complex"/>
    <TTEXTS:has_lexile_level rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">660</TTEXTS:has_lexile_level>
