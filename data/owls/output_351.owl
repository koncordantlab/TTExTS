  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/march">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/geraldine_brooks"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">288.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A retelling of Louisa May Alcott's Little Women, Brooks explores the point of view of the protagonists' absent father.  March confronts the brutal realities of war, slavery, and his own moral failings. He suffers illness, disillusionment, and emotional turmoil, especially as he reflects on the impact of his choices on his family back home. Through his letters and flashbacks, the novel reveals his past, including his relationship with a formerly enslaved woman and his evolving views on race, justice, and personal integrity. Ultimately, he returns home changed, both physically and spiritually.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2005</TTEXTS:has_year_of_publication>
    <TTEXTS:hasEra rdf:resource="https://koncordantlab.com/TTEXTS/Contemporary"/>
    <TTEXTS:has_lexile_level rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">1050</TTEXTS:has_lexile_level>
    <TTEXTS:has_flesch_kincaid rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.32</TTEXTS:has_flesch_kincaid>
