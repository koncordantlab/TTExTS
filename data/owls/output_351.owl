    <TTEXTS:has_reader_maturity rdf:resource="https://koncordantlab.com/TTEXTS/3_to_8"/>
    <TTEXTS:has_genre rdf:resource="https://koncordantlab.com/TTEXTS/genre/Realistic"/>
