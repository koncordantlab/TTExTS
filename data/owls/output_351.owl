  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/all_american_boys">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/jason_reynolds"/>
    <TTEXTS:has_pages rdf:datatype="http://www.w3.org/2001/XMLSchema#numeric">320.0</TTEXTS:has_pages>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rashad, a black teenager is wrongfully accused of theft and Quinn, a white teengager, witnesses the incident, forcing them to confront issues of racism, police brutality, and friendship in their community. </TTEXTS:has_summary>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In All American Boys, two high school studentsRashad, a Black teen brutally beaten by a white police officer, and Quinn, a white teen who witnesses the assault by someone he trustsgrapple with issues of race, justice, and moral courage as their lives intersect in the aftermath of the incident and lead them to take a stand at a community protest.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">2015</TTEXTS:has_year_of_publication>
