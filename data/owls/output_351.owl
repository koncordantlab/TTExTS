    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Tempest by William Shakespeare is a tale of magic, revenge, and forgiveness in which the exiled sorcerer Prospero uses his powers to shipwreck his enemies on a mysterious island, only to ultimately choose reconciliation and freedom over vengeance.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1611</TTEXTS:has_year_of_publication>
