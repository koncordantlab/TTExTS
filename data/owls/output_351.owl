  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/and_the_mountains_echoed">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/khaled_hosseini"/>
