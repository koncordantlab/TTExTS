    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Oliver, a young orphan born into poverty, escapes to London after years of mistreatment and hardship. He joins a gang of child thieves led by Fagin. As Oliver struggles to stay honest amid crime and corruption, his true identity and a hidden inheritance gradually come to light. The novel explores themes of social injustice, child labor, and the struggle between good and evil in a harsh society.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1838</TTEXTS:has_year_of_publication>
