  <rdf:Description rdf:about="https://koncordantlab.com/TTEXTS/mirror">
    <rdf:type rdf:resource="https://koncordantlab.com/TTEXTS/Text"/>
    <TTEXTS:has_author rdf:resource="https://koncordantlab.com/TTEXTS/sylvia_plath"/>
    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Poem"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mirror explores themes of self-perception and truth, portraying a mirror as an unflinching witness to a womans changing identity and her struggle with aging.</TTEXTS:has_summary>
    <TTEXTS:has_year_of_publication rdf:datatype="http://www.w3.org/2001/XMLSchema#gYear">1961</TTEXTS:has_year_of_publication>
