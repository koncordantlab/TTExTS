    <TTEXTS:has_text_type rdf:resource="https://koncordantlab.com/TTEXTS/Novel"/>
    <TTEXTS:has_summary rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Twelve-year-old Claudia Kincaid runs away with her brother Jamie to the Metropolitan Museum of Art in search of independence and purpose, but their adventure leads them to unravel the mystery behind a statue possibly created by Michelangeloand to a deeper understanding of themselves, secrets, and growing up.</TTEXTS:has_summary>
